# --- toolchain per platform ---
ifeq ($(PLATFORM),win)
  CC      = x86_64-w64-mingw32-gcc
  CFLAGS  = -Wall -Wextra -O2 -DWIN32
  OBJDIR  = obj-win
  TARGETS = liblia.dll liblia.dll.a
  PLATFORM_SRCS = ../libwin/libwin.c
else
  CC      = gcc
  CFLAGS  = -Wall -Wextra -O2 -fPIC
  OBJDIR  = obj-linux
  TARGETS = liblia.a liblia.so
  PLATFORM_SRCS = ../liblinux/liblinux.c
endif

# common sources
COMMON_SRCS = $(wildcard *.c) $(wildcard commands/*.c)
SRCS = $(COMMON_SRCS) $(PLATFORM_SRCS)

# Compile all sources into OBJDIR flat
# Flatten objects
OBJS = $(patsubst %.c,$(OBJDIR)/$(notdir %.c).o,$(SRCS))

# Compile rule
$(OBJDIR)/%.o: %.c | $(OBJDIR)
	$(CC) $(CFLAGS) -c $< -o $@

.PHONY: all clean
all: $(TARGETS)

# make sure obj dir exists
$(OBJDIR):
	mkdir -p $(OBJDIR)
	mkdir -p $(OBJDIR)/commands

$(OBJDIR)/../libwin:
	mkdir -p $(OBJDIR)/../libwin

$(OBJDIR)/../liblinux:
	mkdir -p $(OBJDIR)/../liblinux

# per-file compile into platform-specific objdir
#$(OBJDIR)/%.o: %.c | $(OBJDIR)
#	$(CC) $(CFLAGS) -c $< -o $@
#$(OBJDIR)/%_%.c.o: %.c | $(OBJDIR)
#	$(CC) $(CFLAGS) -c $< -o $@

# --- Windows outputs (DLL + import lib) ---
ifeq ($(PLATFORM),win)
liblia.dll liblia.dll.a: $(OBJS)
	$(CC) -shared -o liblia.dll $(OBJS) \
		-Wl,--out-implib,liblia.dll.a -Wl,--enable-auto-import
endif

# --- Linux outputs (static + shared) ---
ifeq ($(PLATFORM),linux)
liblia.a: $(OBJS)
	ar rcs $@ $(OBJS)

liblia.so: $(OBJS)
	$(CC) -shared -o $@ $(OBJS)
endif

clean:
	rm -rf obj-linux obj-win liblia.a liblia.so liblia.dll liblia.dll.a liblia.o
